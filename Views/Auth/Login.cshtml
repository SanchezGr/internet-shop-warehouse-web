@{
    ViewData["Title"] = "Вхід";
}

<div class="container mt-4" style="max-width: 500px;">
    <h2 class="mb-4">Вхід у систему</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Login" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Логін</label>
            <input type="text" name="login" class="form-control" placeholder="Введіть логін" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input type="password" name="password" class="form-control" placeholder="Введіть пароль" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Увійти</button>
            <a asp-action="Register" class="btn btn-secondary">Реєстрація</a>
        </div>
    </form>
</div>