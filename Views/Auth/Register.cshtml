@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container mt-4" style="max-width: 500px;">
    <h2 class="mb-4">Реєстрація</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">@ViewBag.Success</div>
    }

    <form asp-action="Register" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">ПІБ</label>
            <input type="text"
                   name="fullName"
                   class="form-control"
                   placeholder="Введіть ПІБ" />
        </div>

        <div class="mb-3">
            <label class="form-label">Логін</label>
            <input type="text"
                   name="login"
                   class="form-control"
                   placeholder="Введіть логін" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input type="password"
                   name="password"
                   class="form-control"
                   placeholder="Введіть пароль"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   data-bs-custom-class="password-tooltip"
                   title="Пароль має містити щонайменше 6 символів, зокрема одну літеру та одну цифру." />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Зареєструватися</button>
            <a asp-action="Login" class="btn btn-secondary">Увійти</a>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}