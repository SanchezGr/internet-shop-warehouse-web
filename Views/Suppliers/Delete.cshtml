@model InternetShopWarehouseWeb.Models.Supplier

@{
    ViewData["Title"] = "Видалити постачальника";
}

<div class="container mt-4">
    <h2 class="mb-4">Видалити постачальника</h2>

    <div class="alert alert-danger">
        Ви дійсно хочете видалити цього постачальника? Цю дію неможливо скасувати.
    </div>

    <div class="card p-4 shadow-sm">
        <p><strong>Назва:</strong> @Model.Name</p>
        <p><strong>Контактна особа:</strong> @Model.ContactPerson</p>
        <p><strong>Телефон:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @Model.Email</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Видалити</button>
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
        </form>
    </div>
</div>