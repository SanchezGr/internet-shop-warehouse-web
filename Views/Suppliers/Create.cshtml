@model InternetShopWarehouseWeb.Models.Supplier

@{
    ViewData["Title"] = "Додати постачальника";
}

<div class="container mt-4">
    <h2 class="mb-4">Додати постачальника</h2>

    <form asp-action="Create" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Назва постачальника</label>
            <input asp-for="Name" class="form-control" placeholder="Наприклад: Rozetka Trade" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ContactPerson" class="form-label">Контактна особа</label>
            <input asp-for="ContactPerson" class="form-control" placeholder="Наприклад: Іван Петренко" />
            <span asp-validation-for="ContactPerson" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Телефон</label>
            <input asp-for="Phone" class="form-control" placeholder="+380..." />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="supplier@gmail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Зберегти</button>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}