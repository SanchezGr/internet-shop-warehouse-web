@model InternetShopWarehouseWeb.Models.Product

@{
    ViewData["Title"] = "Додати товар";
}

<div class="container mt-4">
    <h2 class="mb-4">Додати товар</h2>

    <form asp-action="Create" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Назва товару</label>
            <input asp-for="Name" class="form-control" placeholder="Наприклад: Клавіатура Logitech" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">Категорія</label>
            <select asp-for="Category" class="form-select">
                <option value="">Оберіть категорію</option>
                <option value="Ноутбуки">Ноутбуки</option>
                <option value="Планшети">Планшети</option>
                <option value="Монітори">Монітори</option>
                <option value="Відеокарти">Відеокарти</option>
                <option value="SSD">SSD</option>
                <option value="Процесори">Процесори</option>
                <option value="Оперативна пам'ять">Оперативна пам'ять</option>
                <option value="Материнські плати">Материнські плати</option>
                <option value="Клавіатури та миші">Клавіатури та миші</option>
                <option value="Мережеве обладнання">Мережеве обладнання</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label">Кількість</label>
            <input asp-for="Quantity" class="form-control" type="number" min="0" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Ціна</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Зберегти</button>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}