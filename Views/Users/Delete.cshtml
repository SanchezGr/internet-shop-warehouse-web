@model InternetShopWarehouseWeb.Models.User

@{
    ViewData["Title"] = "Видалення користувача";
}

<h2>Видалення користувача</h2>

<div class="alert alert-danger mt-3">
    <h5>Ви дійсно хочете видалити цього користувача?</h5>
    <p class="mb-0">Цю дію неможливо скасувати.</p>
</div>

<div class="card mt-3" style="max-width: 600px;">
    <div class="card-body">
        <p><strong>ПІБ:</strong> @Model.FullName</p>
        <p><strong>Логін:</strong> @Model.Login</p>
        <p><strong>Роль:</strong> @Model.Role</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Видалити
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Скасувати
    </a>
</form>