@model IEnumerable<InternetShopWarehouseWeb.Models.User>

@{
    ViewData["Title"] = "Користувачі";
    var currentLogin = Context.Session.GetString("UserLogin");
}

<div class="container mt-4">
    <h2 class="mb-4">Користувачі системи</h2>

    <a asp-action="Create" class="btn btn-success mb-3">
        Додати користувача
    </a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>ПІБ</th>
                <th>Логін</th>
                <th>Роль</th>
                <th style="width: 250px;">Дії</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Login</td>
                    <td>
                        @if (user.Role == "Admin")
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else if (user.Role == "Manager")
                        {
                            <span class="badge bg-primary">Manager</span>
                        }
                        else if (user.Role == "Seller")
                        {
                            <span class="badge bg-success">Seller</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Guest</span>
                        }
                    </td>

                    <td>
                        @if (user.Login != currentLogin)
                        {
                            <a asp-action="EditRole"
                               asp-route-id="@user.Id"
                               class="btn btn-warning btn-sm">
                                Змінити роль
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-danger btn-sm">
                                Видалити
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Поточний акаунт</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>