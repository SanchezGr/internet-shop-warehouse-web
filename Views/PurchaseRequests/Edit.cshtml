@model InternetShopWarehouseWeb.Models.PurchaseRequest

@{
    ViewData["Title"] = "Редагувати заявку";
}

<div class="container mt-4">
    <h2 class="mb-4">Редагувати заявку на закупівлю</h2>

    <form asp-action="Edit" method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="ProductId" class="form-label">Товар</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                <option value="">Оберіть товар</option>
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SupplierId" class="form-label">Постачальник</label>
            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers">
                <option value="">Оберіть постачальника</option>
            </select>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label">Кількість</label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="alert alert-info">
            Редагувати можна тільки нові заявки. Після виконання заявка блокується для змін.
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">Зберегти зміни</button>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}